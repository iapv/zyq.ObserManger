<UserControl x:Class="UserControlLibrary.Commons.LivePanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UserControlLibrary.Commons"
             xmlns:lc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="ProductionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#ff3fbbe6"/>
            <GradientStop Offset="1" Color="#ff2bedf1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DefectBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#E74C3C"/>
            <GradientStop Offset="1" Color="#F9D423"/>
        </LinearGradientBrush>

        <Style TargetType="lc:ColumnSeries">
            <Style.Setters>
                <Setter Property="MaxColumnWidth" Value="10"/>
               
            </Style.Setters>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Title}" Value="生产计数">
                    <Setter Property="Fill" Value="{StaticResource ProductionBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Title}" Value="不良计数">
                    <Setter Property="Fill" Value="{StaticResource DefectBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <lc:CartesianChart Margin="20,35,20,5"
                           Series="{Binding CapacitySeriesData}">
            <lc:CartesianChart.AxisX>
                <lc:Axis Labels="8:00,9:00,10:00,11:00,12:00,13:00,14:00,15:00,16:00">
                    <lc:Axis.Separator>
                        <lc:Separator Step="1" StrokeThickness="0"/>
                    </lc:Axis.Separator>
                </lc:Axis>
            </lc:CartesianChart.AxisX>
            <lc:CartesianChart.AxisY>
                <lc:Axis MinValue="0" MaxValue="300">
                    <lc:Axis.Separator>
                        <lc:Separator Step="100" Stroke="#11ffffff"></lc:Separator>
                    </lc:Axis.Separator> 
                </lc:Axis>
            </lc:CartesianChart.AxisY>

            

            
        </lc:CartesianChart>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,20,0">
            <Border Height="8" Width="8" Background="#ff2bedf1"></Border>
            <TextBlock Text="生产计数" FontSize="12" Foreground="#44ffffff" Margin="5,0"></TextBlock>
            <Border Height="8" Width="8" Background="#E74C3C"></Border>
            <TextBlock Text="不良计数" FontSize="12" Foreground="#44ffffff" Margin="5,0"></TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
