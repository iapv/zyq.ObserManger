<UserControl x:Class="UserControlLibrary.Commons.QualitySeriesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UserControlLibrary.Commons"
             xmlns:lc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 折线下方面积填充：青色带透明 → 完全透明 -->
        <LinearGradientBrush x:Key="AreaFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#662bedf1"/>
            <GradientStop Offset="1" Color="Transparent"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid>
        <lc:CartesianChart Margin="10,35,10,10"
                           Series="{Binding ChartSeriesData}"
                           DisableAnimations="True"
                           Hoverable="False"
                           DataTooltip="{x:Null}">
            <lc:CartesianChart.AxisX>
                <lc:Axis Labels="1#,2#,3#,4#,5#,6#"
                         Foreground="#88ffffff"
                         FontSize="11">
                    <lc:Axis.Separator>
                        <lc:Separator Step="1" StrokeThickness="0"/>
                    </lc:Axis.Separator>
                </lc:Axis>
            </lc:CartesianChart.AxisX>

            <lc:CartesianChart.AxisY>
                <lc:Axis MinValue="0"
                         MaxValue="15"
                         Foreground="#88ffffff"
                         FontSize="11">
                    <lc:Axis.Separator>
                        <lc:Separator Step="5" Stroke="#15ffffff"/>
                    </lc:Axis.Separator>
                </lc:Axis>
            </lc:CartesianChart.AxisY>
        </lc:CartesianChart>
    </Grid>
</UserControl>
