<UserControl x:Class="UserControlLibrary.Controls.ConveyorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:UserControlLibrary.Converters"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="760">

    <UserControl.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrushConverter"/>

        <SolidColorBrush x:Key="BgBrush" Color="#FF0A1321"/>
        <SolidColorBrush x:Key="BorderCyan" Color="#FF00D4FF"/>
        <SolidColorBrush x:Key="CardBg" Color="#FF112B3D"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextDim" Color="#FF8ECAE6"/>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>

        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BorderCyan}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="StationNameStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StationStateStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderCyan}"
            BorderThickness="2"
            CornerRadius="16"
            Padding="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部 KPI -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="产量" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="{Binding Output, StringFormat={}{0:N0}}" Style="{StaticResource KpiValueStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="节拍" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="{Binding CycleTime, StringFormat={}{0} s}" Style="{StaticResource KpiValueStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="良率" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="{Binding PassRate, StringFormat={}{0:F1}%}" Style="{StaticResource KpiValueStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 中间工位区 -->
            <Grid Grid.Row="1" Margin="0,8,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 4 个工位 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- 工位 1：上料 -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Ellipse Width="14" Height="14"
                                 Fill="{Binding Stations[0].State, Converter={StaticResource StateToBrushConverter}}"
                                 HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <Image Source="pack://application:,,,/UserControlLibrary;component/Resource/largeBox.png"
                               Width="60" Height="60" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="Fant"/>
                        <TextBlock Text="{Binding Stations[0].Name}" Style="{StaticResource StationNameStyle}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding Stations[0].State}" Style="{StaticResource StationStateStyle}"/>
                    </StackPanel>

                    <!-- 工位 2：检测 -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Ellipse Width="14" Height="14"
                                 Fill="{Binding Stations[1].State, Converter={StaticResource StateToBrushConverter}}"
                                 HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <Image Source="pack://application:,,,/UserControlLibrary;component/Resource/Camera.png"
                               Width="60" Height="60" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="Fant"/>
                        <TextBlock Text="{Binding Stations[1].Name}" Style="{StaticResource StationNameStyle}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding Stations[1].State}" Style="{StaticResource StationStateStyle}"/>
                    </StackPanel>

                    <!-- 工位 3：装配 -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Ellipse Width="14" Height="14"
                                 Fill="{Binding Stations[2].State, Converter={StaticResource StateToBrushConverter}}"
                                 HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <Image Source="pack://application:,,,/UserControlLibrary;component/Resource/RobotArm.png"
                               Width="60" Height="60" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="Fant"/>
                        <TextBlock Text="{Binding Stations[2].Name}" Style="{StaticResource StationNameStyle}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding Stations[2].State}" Style="{StaticResource StationStateStyle}"/>
                    </StackPanel>

                    <!-- 工位 4：下料 -->
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Ellipse Width="14" Height="14"
                                 Fill="{Binding Stations[3].State, Converter={StaticResource StateToBrushConverter}}"
                                 HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <Image Source="pack://application:,,,/UserControlLibrary;component/Resource/liaodou.png"
                               Width="60" Height="60" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="Fant"/>
                        <TextBlock Text="{Binding Stations[3].Name}" Style="{StaticResource StationNameStyle}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding Stations[3].State}" Style="{StaticResource StationStateStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- 连接线 -->
                <Border Grid.Row="1" Height="1" Background="{StaticResource BorderCyan}" Opacity="0.25" Margin="30,0"/>
            </Grid>

            <!-- 底部传送带 -->
            <Border Grid.Row="2" Height="42"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource BorderCyan}"
                    BorderThickness="1"
                    CornerRadius="21">
                <Canvas ClipToBounds="True">
                    <Rectangle Width="20" Height="20" RadiusX="6" RadiusY="6"
                               Fill="#FFFFB300">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="{Binding MaterialX}" Y="11"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Effect>
                            <DropShadowEffect Color="#FFFFB300" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                        </Rectangle.Effect>
                    </Rectangle>
                </Canvas>
            </Border>
        </Grid>
    </Border>
</UserControl>
