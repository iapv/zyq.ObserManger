<UserControl x:Class="UserControlLibrary.Controls.MonitorAUserControl"
             xmlns:um="clr-namespace:UserControlLibrary.Commons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UserControlLibrary.Controls"
             mc:Ignorable="d" 
             x:Name="root"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Polyline Points="0 30 0 10 10 0 30 0" Stroke="#9918abbd" StrokeThickness="1"/>
                            <Ellipse Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#9918abbd"
                                     Margin="26,-2,0,1"></Ellipse>
                            <Ellipse Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#9918abbd"
         Margin="-2,26,0,1"></Ellipse>

                            <Path Data="M0 0 ,3 3,30 3,33 0, 68 0, 75 7 ,78 10" Stroke="#9918abbd" HorizontalAlignment="Right"></Path>

                            <Polyline Points="0 20 0 30 6 40 20 40" Stroke="#9918abbd" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                            <Polyline Points="40 10 40 30 35 40 20 40" Stroke="#9918abbd" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                            <Path Data="M 0 0 L 25 0" Stroke="#9918abbd" StrokeThickness="1" HorizontalAlignment="Right" Margin="0,0,49,2"/>

                            <Border BorderThickness="0,1,0,0" BorderBrush="#9918abbd" VerticalAlignment="Top" Margin="30,0,78,0"></Border>
                            <Border BorderThickness="1,0,0,0" BorderBrush="#9918abbd" HorizontalAlignment="Left" Margin="0,30,0,20"></Border>
                            <Border BorderThickness="0,0,1,0" BorderBrush="#9918abbd" HorizontalAlignment="Right" Margin="0,10,0,30"></Border>
                            <Border BorderThickness="0,0,0,1" BorderBrush="#9918abbd" VerticalAlignment="Bottom" Margin="20,10,20,0"></Border>

                            <Polyline Points="0 0 6 5 0 10" Stroke="#9918abbd" StrokeThickness="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,10,0,0"/>
                            <Polyline Points="0 0 6 5 0 10" Stroke="#5518abbd" StrokeThickness="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="22,10,0,0"/>

                            <TextBlock Text="{TemplateBinding Header}" Foreground="#fff" FontWeight="Bold" Margin="35,8,0,5" HorizontalAlignment="Left" VerticalAlignment="top" FontSize="14"></TextBlock>
                            <ContentPresenter></ContentPresenter>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
        </Grid.RowDefinitions>
        <!--第一行-->

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" HorizontalAlignment="Center">
                <TextBlock Text="{Binding CurrentTime, ElementName=root}" Foreground="#fff" FontSize="35" VerticalAlignment="Center" FontFamily="pack://application:,,,/Resource/fonts/#Digital Display TFB"></TextBlock>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10,0,0,0" >
                    <TextBlock Text="{Binding CurrentDate, ElementName=root}" Foreground="#fff" FontSize="13"></TextBlock>
                    <TextBlock Text="{Binding CurrentDay, ElementName=root}" Foreground="#fff" FontSize="13" HorizontalAlignment="Right"></TextBlock>
                </StackPanel>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="50,0,0,0" HorizontalAlignment="Left" Grid.Column="1" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <DataTemplate x:Key="dataTime">
                        <Border Width="15" Background="#0A1E3F" Margin="2,0">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#fff" FontSize="16"></TextBlock>
                        </Border>
                    </DataTemplate>
                </StackPanel.Resources>

                <TextBlock Text="机台&#13;总数" VerticalAlignment="Center" Margin="10,0" Foreground="#fff" FontSize="10"></TextBlock>
                <ItemsControl ItemsSource="{Binding MachineTotal, ElementName=root}"
                              ItemTemplate="{StaticResource dataTime}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="生产计数" VerticalAlignment="Center" Margin="10,0" Foreground="#fff" FontSize="10"></TextBlock>
                <ItemsControl ItemsSource="{Binding ProductionCount, ElementName=root}"
                              ItemTemplate="{StaticResource dataTime}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="不良计数" VerticalAlignment="Center" Margin="10,0" Foreground="#fff" FontSize="10"></TextBlock>
                <ItemsControl ItemsSource="{Binding DefectCount, ElementName=root}"
              ItemTemplate="{StaticResource dataTime}"
              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>


            </StackPanel>
            <Border Width="75" Height="30" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" BorderThickness="1" BorderBrush="#f0f0f2" CornerRadius="10">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xe696;" Foreground="#f0f0f2" FontSize="13" FontFamily="{StaticResource IconFont}" Margin="0,0,5,0"></TextBlock>
                    <TextBlock Text="配置" Foreground="#fff" FontSize="13"></TextBlock>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏 -->
            <UniformGrid Columns="1">
                <GroupBox Header="环境" >
                    <StackPanel Margin="26">
                        <um:PanelAdapter DataContext="{Binding PanelAdapterVm}"></um:PanelAdapter>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="产能" >
                    <um:LivePanelControl DataContext="{Binding ProductionHourliesVm}"></um:LivePanelControl>
                </GroupBox>
                <GroupBox Header="质量" >
                    <um:QualitySeriesControl DataContext="{Binding QualityHistoryVm}"></um:QualitySeriesControl>
                </GroupBox>
            </UniformGrid>

            <!-- 中栏 -->
            <StackPanel Grid.Column="1" Margin="10,0" Background="Transparent">
                <!-- 设备图、报警、饼图 -->
                <GroupBox Header="产线运行">
                    <local:ConveyorControl DataContext="{Binding ConveyorVm}" />
                </GroupBox>

            </StackPanel>

            <!-- 右栏 -->
            <StackPanel Grid.Column="2" Margin="10,0">
                <!-- 设备、能耗、人力 -->
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
